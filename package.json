{
  "name": "chrome-ext-save-element-to-pdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.content.js",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.js\"",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "test:browser": "node --test \"test/browser/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.16.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
